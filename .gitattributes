app/lib/** -text
*.onnx binary
*.wasm binary
# Linux servers and Docker need Unix line endings
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
deploy/oracle/* text eol=lf
*.yml text eol=lf

# One line-ending convention everywhere, so any checkout builds byte-identical images
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
